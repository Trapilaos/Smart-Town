# Copy to .env (which is git-ignored) and replace the value.
# JWT signing key: at least 64 characters. Generate one with: openssl rand -base64 64
TOKEN_KEY=CHANGE-ME-replace-with-a-random-string-of-at-least-64-characters-0123456789

# Initial admin password, used only when no admin account exists yet. At least 6 characters,
# with an upper case letter, a lower case letter and a digit.
ADMIN_PASSWORD=
